[Unit]
Description=Manual Cloud Minimal TT-Sync Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/manual-cloud-sync
EnvironmentFile=/etc/manual-cloud-tt-sync.env
ExecStart=/usr/bin/npm run tt-sync:server
Restart=on-failure
RestartSec=5
User=manual-cloud-sync
Group=manual-cloud-sync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manual-cloud-tt-sync

[Install]
WantedBy=multi-user.target
